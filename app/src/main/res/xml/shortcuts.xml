<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:shortcutId="capture"
        android:shortcutLongLabel="@string/capture_shortcut_long"
        android:shortcutShortLabel="@string/capture_shortcut_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.pulso.app.CaptureActivity"
            android:targetPackage="dev.pulso.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutId="capture_voice"
        android:shortcutLongLabel="@string/voice_shortcut_long"
        android:shortcutShortLabel="@string/voice_shortcut_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.pulso.app.CaptureActivity"
            android:targetPackage="dev.pulso.app">
            <extra android:name="dev.pulso.app.extra.START_VOICE" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
